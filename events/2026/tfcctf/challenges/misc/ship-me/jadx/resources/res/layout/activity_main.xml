<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:paddingTop="36dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="22dp"
    android:paddingEnd="22dp">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:src="@drawable/ic_ship"
            android:tint="@color/aqua"
            android:contentDescription="@string/ship_icon_description"/>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp">
            <TextView
                android:textSize="27sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.06"/>
            <TextView
                android:textSize="12sp"
                android:textColor="@color/slate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"/>
        </LinearLayout>
    </LinearLayout>
    <Button
        android:id="@+id/create_package"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/create_package"
        android:filterTouchesWhenObscured="true"
        android:textAllCaps="false"/>
    <TextView
        android:textSize="12sp"
        android:textColor="@color/slate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:layout_marginBottom="12dp"
        android:text="@string/your_packages"
        android:textAllCaps="true"
        android:fontFamily="sans-serif-medium"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <TextView
            android:textSize="15sp"
            android:textColor="@color/slate"
            android:gravity="center"
            android:id="@+id/empty_state"
            android:padding="36dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="@string/no_packages"/>
        <ScrollView
            android:paddingBottom="22dp"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">
            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/package_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </ScrollView>
    </FrameLayout>
</LinearLayout>
